---
interface Category {
  id: string;
  label: string;
  description?: string;
}

interface Domain {
  id: string;
  label: string;
  description?: string;
  categories: Category[];
}

interface Props {
  domains: Domain[];
  entryCounts: Record<string, number>;
}

const { domains, entryCounts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="grid gap-6 md:grid-cols-2">
  {domains.map((domain) => {
    const total = domain.categories.reduce((sum, c) => sum + (entryCounts[c.id] || 0), 0);
    // Bars compare categories within a domain; a global scale hid small domains entirely.
    const maxCount = Math.max(...domain.categories.map((c) => entryCounts[c.id] || 0), 1);
    return (
      <section class={`surface p-6 domain-${domain.id}`} aria-labelledby={`domain-${domain.id}`}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 id={`domain-${domain.id}`} class="scroll-mt-24 flex items-center gap-2.5 text-lg font-semibold tracking-tight text-gray-900">
              <span class="dot h-2.5 w-2.5"></span>{domain.label}
            </h2>
            {domain.description && <p class="mt-1.5 text-sm leading-relaxed text-gray-600">{domain.description}</p>}
          </div>
          <span class="num shrink-0 font-mono text-xs text-gray-500">{total.toLocaleString('en-US')}</span>
        </div>
        <ul class="mt-5 divide-y divide-gray-100">
          {domain.categories.map((cat) => {
            const count = entryCounts[cat.id] || 0;
            return (
              <li>
                <a
                  href={`${base}browse/${cat.id}/`}
                  class="group -mx-2 grid grid-cols-[1fr_5rem_2.5rem] items-center gap-3 rounded-lg px-2 py-2.5 text-gray-800 no-underline transition-colors hover:bg-gray-50 hover:text-gray-900"
                  title={cat.description}
                >
                  <span class="truncate text-sm font-medium group-hover:text-primary-800">{cat.label}</span>
                  <span class="block h-1 overflow-hidden rounded-full bg-gray-100" aria-hidden="true">
                    <span class="block h-full rounded-full" style={`width: ${count ? Math.max(4, (count / maxCount) * 100) : 0}%; background: var(--domain)`}></span>
                  </span>
                  <span class:list={['num text-right font-mono text-xs', count ? 'text-gray-600' : 'text-gray-400']}>{count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>

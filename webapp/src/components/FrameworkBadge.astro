---
/** A framework item reference: mono ID, optionally followed by the item's name. */
interface Props {
  framework: string;
  id: string;
  name?: string;
  /** Show the framework's short label before the ID */
  showFramework?: boolean;
}

const { framework, id, name, showFramework = false } = Astro.props;

const labels: Record<string, string> = {
  owasp_llm_top10: 'OWASP LLM',
  owasp_agentic_top10: 'OWASP Agentic',
  mitre_atlas: 'MITRE ATLAS',
  nist_ai_rmf: 'NIST AI RMF',
  iso_42001: 'ISO 42001',
};
---

<span class="inline-flex max-w-full items-center gap-2 text-sm text-gray-800">
  <span class="chip-plain shrink-0">{showFramework && <span class="mr-1 text-gray-500">{labels[framework] ?? framework}</span>}{id}</span>
  {name && <span class="truncate">{name}</span>}
</span>

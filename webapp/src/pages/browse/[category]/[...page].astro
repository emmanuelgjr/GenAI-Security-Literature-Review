---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { domainClass } from '../../../categoryColors';
import literature from '../../../data/literature.json';
import taxonomy from '../../../data/taxonomy.json';

// Popular categories hold hundreds of entries; one page per category grew past
// 600 KB of HTML. Page 1 keeps the /browse/<category>/ URL, later pages are
// /browse/<category>/2/, ...

interface Category {
  id: string;
  label: string;
  domainLabel: string;
  description?: string;
}

export const getStaticPaths = (({ paginate }) => {
  // Declared here: Astro hoists getStaticPaths out of the component scope.
  const PAGE_SIZE = 50;
  return taxonomy.domains.flatMap((domain) =>
    domain.categories.flatMap((c) => {
      const cat: Category = { id: c.id, label: c.label, domainLabel: domain.label, description: c.description };
      const entries = literature.entries
        .filter((e: any) => e.categories.includes(cat.id))
        .sort((a: any, b: any) => b.year - a.year || (b.citation_count || 0) - (a.citation_count || 0));
      return paginate(entries, { params: { category: cat.id }, props: { cat }, pageSize: PAGE_SIZE });
    })
  );
}) satisfies GetStaticPaths;

interface Props {
  cat: Category;
  page: Page<any>;
}

const { cat, page } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageSuffix = page.currentPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : '';
const description = `${page.total} GenAI security ${page.total === 1 ? 'resource' : 'resources'} on ${cat.label}${cat.description ? `: ${cat.description}` : '.'}`;
const reviewedOnPage = page.data.filter((e: any) => e.reviewed).length;
---

<BaseLayout title={`${cat.label}${pageSuffix}`} description={description}>
  <nav aria-label="Breadcrumb" class="text-sm">
    <ol class="flex flex-wrap items-center gap-2 text-gray-500">
      <li><a href={`${base}browse/`} class="text-gray-600 no-underline hover:text-gray-900">Browse</a></li>
      <li aria-hidden="true" class="text-gray-300">/</li>
      <li class={`flex items-center gap-2 ${domainClass(cat.id)}`}><span class="dot"></span>{cat.domainLabel}</li>
    </ol>
  </nav>

  <header class="mt-6 flex flex-wrap items-end justify-between gap-6 border-b border-gray-200/80 pb-8">
    <div class="max-w-2xl">
      <h1 class="display text-4xl sm:text-5xl">{cat.label}</h1>
      {cat.description && <p class="mt-3 text-lg leading-relaxed text-gray-600">{cat.description}</p>}
    </div>
    <dl class="flex gap-8">
      <div>
        <dt class="meta-label">Resources</dt>
        <dd class="display num mt-1 text-3xl">{page.total.toLocaleString('en-US')}</dd>
      </div>
      {page.lastPage > 1 && (
        <div>
          <dt class="meta-label">Page</dt>
          <dd class="display num mt-1 text-3xl">{page.currentPage}<span class="text-gray-400">/{page.lastPage}</span></dd>
        </div>
      )}
    </dl>
  </header>

  {page.total > 0 ? (
    <div class="mt-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-gray-500">
        <p>Newest first{reviewedOnPage > 0 && ` · ${reviewedOnPage} reviewed on this page`}</p>
        <a href={`${base}search/`} class="link-arrow">Search instead</a>
      </div>
      <div class="space-y-3">
        {page.data.map((entry: any) => <EntryCard entry={entry} />)}
      </div>
      <Pagination page={page} />
    </div>
  ) : (
    <div class="surface mt-8 px-6 py-16 text-center">
      <p class="display text-2xl">Nothing filed here yet</p>
      <p class="mx-auto mt-2 max-w-md text-gray-600">
        If you know a paper, tool or standard on {cat.label.toLowerCase()}, suggest it and it will be reviewed for inclusion.
      </p>
      <a
        href="https://github.com/emmanuelgjr/GenAI-Security-Literature-Review/issues/new?template=add-resource.md"
        class="btn-primary mt-6"
      >Suggest a resource</a>
    </div>
  )}
</BaseLayout>

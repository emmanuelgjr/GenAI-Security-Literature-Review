---
import BaseLayout from '../layouts/BaseLayout.astro';
import literature from '../data/literature.json';
import frameworksData from '../data/frameworks.json';

const entries = literature.entries;
const base = import.meta.env.BASE_URL;
const PREVIEW = 4;
// Listing every mapped entry pushed the page past 750 KB; show the most cited.
const MAX_LISTED = 12;

type Entry = (typeof entries)[number];

// framework id -> item id -> entries, most cited first
const frameworks = frameworksData.frameworks.map((fw) => {
  const items = fw.entries.map((item) => {
    const matching = entries
      .filter((e) => ((e as any).framework_mappings?.[fw.id] ?? []).includes(item.id))
      .sort((a: Entry, b: Entry) => (b.citation_count || 0) - (a.citation_count || 0) || b.year - a.year);
    return { ...item, entries: matching };
  });
  const mapped = new Set(items.flatMap((i) => i.entries.map((e) => e.id))).size;
  return { ...fw, items, mapped };
});
---

<BaseLayout title="Framework Mappings" description="GenAI security resources mapped to the OWASP Top 10 for LLM and Agentic Applications, MITRE ATLAS, NIST AI RMF, and ISO/IEC 42001.">
  <header class="max-w-2xl">
    <p class="eyebrow">Frameworks</p>
    <h1 class="display mt-3 text-4xl sm:text-5xl">Research, mapped to the standards</h1>
    <p class="mt-4 text-lg leading-relaxed text-gray-600">
      Find the papers and tools behind each OWASP risk, MITRE ATLAS technique, NIST AI RMF function and ISO/IEC 42001 clause. Mappings on unreviewed entries are suggested from their categories.
    </p>
  </header>

  <nav aria-label="Frameworks" class="sticky top-16 z-30 -mx-4 mt-10 border-b border-gray-200/80 bg-paper/85 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-xl sm:border sm:px-3">
    <ul class="flex gap-1 overflow-x-auto text-sm [scrollbar-width:none]">
      {frameworks.map((fw) => (
        <li class="shrink-0">
          <a href={`#${fw.id}`} class="flex items-center gap-2 rounded-lg px-3 py-1.5 font-medium text-gray-700 no-underline hover:bg-gray-900/[0.05] hover:text-gray-900">
            {fw.name.replace(/^OWASP Top 10 for /, 'OWASP ')}
            <span class="num font-mono text-[11px] text-gray-500">{fw.mapped}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-12 space-y-16">
    {frameworks.map((fw) => (
      <section id={fw.id} class="scroll-mt-36" aria-labelledby={`${fw.id}-title`}>
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-gray-900 pb-4">
          <div>
            <h2 id={`${fw.id}-title`} class="display text-3xl">{fw.name}</h2>
            <p class="mt-1 text-sm text-gray-500">
              <span class="num font-mono text-xs">v{fw.version}</span> · {fw.mapped.toLocaleString('en-US')} mapped resources
            </p>
          </div>
          <a href={fw.url} target="_blank" rel="noopener noreferrer" class="link-arrow text-sm">Official source</a>
        </div>

        <div class="grid gap-3 pt-6 md:grid-cols-2">
          {fw.items.map((item) => (
            <div class:list={['surface flex flex-col p-5', item.entries.length === 0 && 'bg-white/60']}>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <span class="chip-plain">{item.id}</span>
                  <h3 class="mt-2 font-semibold leading-snug text-gray-900">{item.name}</h3>
                </div>
                <span class:list={['num shrink-0 font-mono text-sm', item.entries.length ? 'text-gray-900' : 'text-gray-400']}>
                  {item.entries.length}
                </span>
              </div>
              {'description' in item && item.description && (
                <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.description}</p>
              )}
              {item.entries.length > 0 && (
                <ul class="mt-4 space-y-2 border-t border-gray-100 pt-4">
                  {item.entries.slice(0, PREVIEW).map((entry) => (
                    <li class="flex items-baseline justify-between gap-3 text-sm">
                      <a href={`${base}entry/${entry.id}/`} class="line-clamp-1 text-gray-800 no-underline hover:text-primary-800">{entry.title}</a>
                      <span class="num shrink-0 font-mono text-[11px] text-gray-500">{entry.year}</span>
                    </li>
                  ))}
                </ul>
              )}
              {item.entries.length > PREVIEW && (
                <details class="group mt-2 text-sm">
                  <summary class="cursor-pointer list-none font-medium text-primary-700 hover:text-primary-900 [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">Show {Math.min(item.entries.length, MAX_LISTED) - PREVIEW} more</span>
                    <span class="hidden group-open:inline">Show fewer</span>
                  </summary>
                  <ul class="mt-2 space-y-2">
                    {item.entries.slice(PREVIEW, MAX_LISTED).map((entry) => (
                      <li class="flex items-baseline justify-between gap-3">
                        <a href={`${base}entry/${entry.id}/`} class="line-clamp-1 text-gray-800 no-underline hover:text-primary-800">{entry.title}</a>
                        <span class="num shrink-0 font-mono text-[11px] text-gray-500">{entry.year}</span>
                      </li>
                    ))}
                  </ul>
                  {item.entries.length > MAX_LISTED && (
                    <p class="mt-3 text-xs text-gray-500">
                      Most cited shown; {(item.entries.length - MAX_LISTED).toLocaleString('en-US')} more are mapped here.
                    </p>
                  )}
                </details>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import taxonomy from '../data/taxonomy.json';
import { allEntries, reviewedEntries } from '../lib/dataset';

const base = import.meta.env.BASE_URL;
const totalEntries = allEntries.length;
const totalCategories = taxonomy.domains.reduce((s, d) => s + d.categories.length, 0);
---

<BaseLayout title="About" description="How the GenAI Security Literature Review is built: sources, taxonomy, framework mappings, automated discovery, and how to contribute.">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">About This Project</h1>

    <div class="prose prose-gray max-w-none">
      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-3">What is this?</h2>
        <p class="text-gray-700 mb-4">
          The GenAI Security Literature Review is a comprehensive, community-driven, auto-updating database of research, standards, tools, and resources related to the security of Large Language Models (LLMs) and AI systems.
        </p>
        <p class="text-gray-700">
          Currently tracking <strong>{totalEntries} resources</strong> across <strong>{totalCategories} categories</strong> in <strong>{taxonomy.domains.length} domains</strong>.
        </p>
      </div>

      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-3">How It Works</h2>
        <div class="space-y-4 text-gray-700">
          <div>
            <h3 class="font-semibold text-gray-900">Auto-Discovery</h3>
            <p>A weekly GitHub Action collects new papers from arXiv, Semantic Scholar and CrossRef and proposes them in a pull request for human review before they are merged into the database.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Human Curation</h3>
            <p>Curated entries are categorized using our taxonomy, mapped to relevant security frameworks (OWASP, NIST, MITRE ATLAS, ISO 42001), and tagged. Automatically added entries get keyword-based categories and stay marked as not yet reviewed until a maintainer vets them. Anyone can suggest a resource via GitHub Issues.</p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Quality Signals</h3>
            <p>Entries marked as "reviewed" have been vetted by a human; unreviewed entries carry a badge. Every change to the data is validated against the schema in CI. Citation counts, open-access status, and venue information help you prioritize what to read.</p>
          </div>
        </div>
      </div>

      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-3">Coverage</h2>
        <p class="text-gray-700 mb-4">We cover the full LLM/AI security landscape:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {taxonomy.domains.map(domain => (
            <div class="bg-gray-50 rounded-md p-3">
              <h4 class="font-semibold text-gray-900 text-sm">{domain.label}</h4>
              <p class="text-xs text-gray-500">{domain.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-3">Framework Mappings</h2>
        <p class="text-gray-700 mb-3">Entries are mapped (where applicable) to these security frameworks:</p>
        <ul class="list-disc pl-5 text-gray-700 space-y-1">
          <li><strong>OWASP Top 10 for LLM Applications</strong> -- the most widely adopted LLM security standard</li>
          <li><strong>OWASP Top 10 for Agentic Applications</strong> -- security risks specific to autonomous AI agents</li>
          <li><strong>MITRE ATLAS</strong> -- adversarial tactics, techniques, and case studies for AI systems</li>
          <li><strong>NIST AI RMF</strong> -- the US government's AI risk management framework</li>
          <li><strong>ISO/IEC 42001</strong> -- international standard for AI management systems</li>
        </ul>
      </div>

      <div class="card mb-6" id="download">
        <h2 class="text-xl font-semibold mb-3">Download the Dataset</h2>
        <p class="text-gray-700 mb-4">The full database is available for analysis, citation managers, and systematic reviews. Files are regenerated on every deploy.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="text-gray-500 border-b border-gray-200">
              <tr><th class="py-2 pr-4 font-medium">Format</th><th class="py-2 pr-4 font-medium">All entries ({totalEntries})</th><th class="py-2 font-medium">Reviewed only ({reviewedEntries.length})</th></tr>
            </thead>
            <tbody class="text-gray-700">
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-4">JSON <span class="text-gray-500">(complete records)</span></td>
                <td class="py-2 pr-4"><a href={`${base}literature.json`} download>literature.json</a></td>
                <td class="py-2 text-gray-500">filter on <code>reviewed</code></td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-4">CSV <span class="text-gray-500">(spreadsheets, pandas)</span></td>
                <td class="py-2 pr-4"><a href={`${base}literature.csv`} download>literature.csv</a></td>
                <td class="py-2"><a href={`${base}literature-reviewed.csv`} download>literature-reviewed.csv</a></td>
              </tr>
              <tr>
                <td class="py-2 pr-4">BibTeX <span class="text-gray-500">(Zotero, LaTeX)</span></td>
                <td class="py-2 pr-4"><a href={`${base}literature.bib`} download>literature.bib</a></td>
                <td class="py-2"><a href={`${base}literature-reviewed.bib`} download>literature-reviewed.bib</a></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-gray-500 mt-3">
          {totalEntries - reviewedEntries.length} entries have <code>reviewed: false</code>: they were added automatically from academic APIs and have not been curated yet. Licensed under MIT; citation keys match the BibTeX shown on each entry page.
        </p>
      </div>

      <div class="card mb-6">
        <h2 class="text-xl font-semibold mb-3">Contributing</h2>
        <p class="text-gray-700 mb-4">We welcome contributions from the community:</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/emmanuelgjr/GenAI-Security-Literature-Review/issues/new?template=add-resource.md" class="bg-primary-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-primary-700 no-underline">
            Submit a Resource
          </a>
          <a href="https://github.com/emmanuelgjr/GenAI-Security-Literature-Review" class="bg-white text-primary-600 px-4 py-2 rounded-md text-sm font-medium border border-primary-600 hover:bg-primary-50 no-underline">
            View on GitHub
          </a>
        </div>
      </div>

      <div class="card">
        <h2 class="text-xl font-semibold mb-3">Maintainer</h2>
        <p class="text-gray-700">
          <strong>Emmanuel Guilherme</strong> (<a href="https://github.com/emmanuelgjr">@emmanuelgjr</a>) -- OWASP contributor and GenAI data security researcher.
        </p>
        <p class="text-gray-700 mt-2">
          Licensed under the <a href="https://opensource.org/licenses/MIT">MIT License</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
